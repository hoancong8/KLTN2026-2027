	<string>Ứng dụng cần quyền truy cập camera để tham gia cuộc họp video</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Sử dụng Face ID để đăng nhập nhanh và bảo mật</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Ứng dụng cần quyền truy cập vị trí để hỗ trợ các tính năng liên quan đến địa điểm</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Ứng dụng cần quyền truy cập vị trí để hỗ trợ các tính năng liên quan đến địa điểm</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Ứng dụng cần quyền truy cập microphone để tham gia cuộc họp</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Ứng dụng cần quyền lưu ảnh vào thư viện</string>
